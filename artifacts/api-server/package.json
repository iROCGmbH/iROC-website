{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "pnpm -w run typecheck:libs && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "validate:facturx": "node ./scripts/validate-facturx-independent.mjs"
  },
  "dependencies": {
    "@stackforge-eu/factur-x": "1.2.0",
    "@babel/parser": "^7.29.7",
    "@google-cloud/storage": "^7.21.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/qrcode": "^1.5.6",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-gemini-ai": "workspace:*",
    "@workspace/spirecut-shared": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.0",
    "imapflow": "^1.6.6",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^1.1.4",
    "pdfkit": "^0.19.1",
    "pdf-lib": "^1.17.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jszip": "^3.4.1",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "vitest": "^4.1.10"
  }
